{
  "name": "toolbox-mcp",
  "version": "0.6.1",
  "description": "Local-first MCP server exposing Toolbox widgets (crypto watch, Gmail announcer, resource monitor) plus a localhost ops panel.",
  "author": "Alpha Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acsdd/toolbox-mcp.git"
  },
  "homepage": "https://github.com/acsdd/toolbox-mcp#readme",
  "bugs": {
    "url": "https://github.com/acsdd/toolbox-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "toolbox",
    "ollama",
    "marketplace",
    "astrlink"
  ],
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "toolbox-mcp": "./dist/index.js"
  },
  "files": [
    "dist/**/*.js",
    "scripts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && node dist/index.js",
    "panel": "npm run build && node dist/panel.js",
    "portable": "node scripts/pack-portable.mjs",
    "release:notes": "node scripts/release-notes.cjs",
    "test": "npm run build && node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.0",
    "@toolbox/widgets": "file:../toolbox-widgets",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  }
}
