{
  "name": "toolbox-mcp",
  "version": "0.2.0",
  "description": "Private local MCP server exposing Toolbox widgets (crypto watch, Gmail announcer, resource monitor) plus a localhost ops panel.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "toolbox-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && node dist/index.js",
    "panel": "npm run build && node dist/panel.js",
    "test": "npm run build && node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.0",
    "@toolbox/widgets": "file:../toolbox-widgets",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  }
}
